# Tokyo Night themed swaylock (swaylock-effects)
# Pallete: https://github.com/folke/tokyonight.nvim

font=JetBrains Mono
font-size=16

color=1a1b26

screenshots
effect-blur=7x5
effect-vignette=0.5:0.5

clock
timestr=%H:%M
datestr=%A, %d %B

indicator-idle-visible
show-keyboard-layout
indicator-caps-lock
indicator-radius=60
indicator-thickness=6

# Unlock indicator
inside-color=1a1b26
inside-clear-color=3b4261
inside-ver-color=2ac3de
inside-wrong-color=f7768e

line-color=00000000
line-uses-inside

ring-color=1a1b26
ring-clear-color=3b4261
ring-ver-color=2ac3de
ring-wrong-color=f7768e

separator-color=00000000

key-hl-color=7aa2f7
bs-hl-color=f7768e
caps-lock-key-hl-color=7aa2f7

text-color=c0caf5
text-clear-color=c0caf5
text-ver-color=1a1b26
text-wrong-color=f7768e

layout-bg-color=1a1b26
layout-border-color=00000000
layout-text-color=c0caf5
