font=JetBrains Mono 10

background-color=#1A1B26E0
text-color=#C0CAF5
border-color=#C0CAF580
progress-color=over #C0CAF580

width=300
border-size=1
border-radius=6
padding=8
margin=3
outer-margin=12

icons=1
max-icon-size=48
icon-border-radius=3
icon-location=left
icon-path=/usr/share/icons/Papirus-Dark:/usr/share/icons/hicolor

markup=1
format=<b>%s</b>\n<span size='small'>%b</span>
text-alignment=left

default-timeout=10000
ignore-timeout=0

sort=-time
max-history=10
max-visible=20

anchor=top-right
layer=top

on-button-left=invoke-default-action
on-button-right=dismiss

[urgency=low]
background-color=#16161EE0
text-color=#C0CAF5
border-color=#C0CAF580

[urgency=normal]
background-color=#1A1B26E0
text-color=#C0CAF5
border-color=#C0CAF580

[urgency=critical]
background-color=#292E42E0
text-color=#DB4B4B
border-color=#DB4B4B80
default-timeout=60000

[summary=wall-changer]
max-icon-size=96

