{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "padding": {
      "top": 2,
    },
  },
  "display": {
    "separator": "\t",
  },
  "modules": [
    "title",
    {
      "type": "host",
      "key": "host",
      "format": "{family}",
    },
    {
      "type": "os",
      "key": "os",
      "format": "{name}",
    },
    {
      "type": "uptime",
      "key": "uptime",
      "format": "{days}d {hours}h {minutes}m",
    },
    {
      "type": "kernel",
      "key": "kernel",
    },
    {
      "type": "wm",
      "key": "wm",
    },
    {
      "type": "command",
      "key": "cpu",
      "format": "{result}",
      "shell": "/bin/sh",
      "text": "echo $(cat /proc/cpuinfo | grep 'model name' | uniq | sed 's/.*: //; s/ with.*//') w/ $(lspci | grep -iE 'vga|3d|display' | sed 's/.*\\[\\(.*\\)\\].*/\\1/') Graphics",
    },
    // {
    //   "type": "cpu",
    //   "key": "cpu",
    //   "format": "{name}",
    // },
    // {
    //   "type": "gpu",
    //   "key": "gpu",
    // },
    {
      "type": "memory",
      "key": "memory",
    },
    {
      "type": "swap",
      "key": "swap",
    },
    {
      "type": "disk",
      "key": "disk",
    },
  ],
}
