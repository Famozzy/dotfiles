{
  "editor.fontFamily": "'Jetbrains Mono', 'monospace'",
  "editor.fontLigatures": true,
  "editor.minimap.enabled": false,
  "editor.scrollbar.verticalScrollbarSize": 11,
  "editor.fontSize": 11,
  "terminal.integrated.fontSize": 12,
  "editor.defaultFormatter": "biomejs.biome",
  "editor.tabSize": 2,
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.biome": "explicit"
  },
  "editor.tokenColorCustomizations": {
    "[Tokyo Night]": {
      "textMateRules": [
        {
          "scope": [
            "comment keyword.codetag.notation",
            "comment.block.documentation keyword",
            "comment.block.documentation storage.type.class"
          ],
          "settings": {
            "foreground": "#bb9af7"
          }
        },
        {
          "scope": ["comment.block.documentation entity.name.type.instance"],
          "settings": {
            "foreground": "#73daca",
            "fontStyle": "italic"
          }
        },
        {
          "scope": [
            "comment.block.documentation entity.name.type punctuation.definition.bracket"
          ],
          "settings": {
            "foreground": "#bb9af7"
          }
        },
        {
          "scope": ["comment.block.documentation variable"],
          "settings": {
            "foreground": "#e0af68",
            "fontStyle": "italic"
          }
        },
        {
          // disable italic
          "scope": [
            "comment",
            "meta.var.expr storage.type",
            "keyword.control.flow",
            "keyword.control.return",
            "meta.directive.vue punctuation.separator.key-value.html",
            "meta.directive.vue entity.other.attribute-name.html",
            "tag.decorator.js entity.name.tag.js",
            "tag.decorator.js punctuation.definition.tag.js",
            "storage.modifier"
          ],
          "settings": {
            "fontStyle": ""
          }
        }
      ]
    }
  },
  "terminal.integrated.fontFamily": "'Jetbrains Mono', 'monospace'",
  "security.workspace.trust.untrustedFiles": "newWindow",
  "security.workspace.trust.startupPrompt": "never",
  "security.workspace.trust.enabled": false,
  "workbench.iconTheme": "material-icon-theme",
  "github.copilot.enable": {
    "*": true,
    "plaintext": true,
    "markdown": true,
    "scminput": false,
    "typescript": true,
    "typescriptreact": true
  },
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.enableMultiLinePasteWarning": "never",
  "telemetry.telemetryLevel": "off",
  "workbench.startupEditor": "none",
  "explorer.confirmDelete": false,
  "[go]": {
    "editor.tabSize": 4,
    "editor.defaultFormatter": "golang.go"
  },
  "github.copilot.editor.enableAutoCompletions": true,
  "vscord.status.idle.timeout": 600,
  "vscord.status.details.text.noWorkSpaceText": "no workspace",
  "vscord.status.buttons.button1.git.active.enabled": false,
  "vscord.app.name": "Visual Studio Code",
  "vscord.status.idle.resetElapsedTime": true,
  "vscord.status.problems.text": "",
  "vscord.status.details.idle.enabled": false,
  "window.customTitleBarVisibility": "never",
  "workbench.activityBar.location": "top",
  "workbench.editor.enablePreview": false,
  "prettier.singleQuote": true,
  "prettier.printWidth": 120,
  "prettier.semi": false,
  "prettier.trailingComma": "none",
  "diffEditor.ignoreTrimWhitespace": false,
  "git.confirmSync": false,
  "[typst]": {
    "editor.formatOnSave": true,
    "editor.wordSeparators": "`~!@#$%^&*()=+[{]}\\|;:'\",.<>/?",
    "editor.defaultFormatter": "myriad-dreamin.tinymist"
  },
  "tinymist.formatterMode": "typstyle",
  "[typst-code]": {
    "editor.wordSeparators": "`~!@#$%^&*()=+[{]}\\|;:'\",.<>/?"
  },
  "github.copilot.nextEditSuggestions.enabled": false,
  "git.openRepositoryInParentFolders": "always",
  "remote.portsAttributes": {
    "3000": {
      "protocol": "https"
    }
  },
  "containers.containerClient": "com.microsoft.visualstudio.containers.docker",
  "containers.orchestratorClient": "com.microsoft.visualstudio.orchestrators.dockercompose",
  "remote.SSH.useExecServer": false,
  "python.createEnvironment.trigger": "off",
  "json.schemaDownload.trustedDomains": {
    "https://schemastore.azurewebsites.net/": true,
    "https://raw.githubusercontent.com/": true,
    "https://www.schemastore.org/": true,
    "https://json.schemastore.org/": true,
    "https://json-schema.org/": true,
    "https://biomejs.dev": true
  },
  "chat.useNestedAgentsMdFiles": true,
  "chat.mcp.gallery.enabled": true,
  "window.menuBarVisibility": "compact",
  "chat.tips.enabled": false,
  "biome.requireConfiguration": true,
  "terminal.integrated.stickyScroll.enabled": false,
  "js/ts.suggest.includeCompletionsForImportStatements": false,
  "github.copilot.nextEditSuggestions.eagerness": "high",
  "js/ts.updateImportsOnFileMove.enabled": "never",
  "chat.viewSessions.orientation": "stacked",
  "workbench.colorTheme": "Tokyo Night Dark",
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  }
}
