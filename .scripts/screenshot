#!/usr/bin/env bash
set -euo pipefail
mkdir -p "$HOME/Pictures/Screenshots"
filepath="$HOME/Pictures/Screenshots/$(date +%Y%m%d%H%M%S).png"

case "${1:-fullscreen}" in
  window)
    g=$(mmsg get focusing-client | jq -r '"\(.x),\(.y) \(.width)x\(.height)"')
    [ -z "$g" ] && exit 1
    grim -g "$g" - | tee "$filepath" | wl-copy
    notify-send "Screenshot" "Window copied to clipboard & saved to Screenshots" -i "$filepath" ;;
  
  region)
    g=$(slurp -d); [ -z "$g" ] && exit 1
    tmp=$(mktemp /tmp/screenshot-XXXXXX.png)
    grim -g "$g" - | tee "$tmp" | wl-copy
    notify-send "Screenshot" "Region copied to clipboard" -i "$tmp"
    (sleep 5; rm -f "$tmp") & ;;
    
  *) 
    mon=$(mmsg get all-monitors | jq -r '.monitors[] | select(.active) | .name')
    grim -o "$mon" "$filepath"
    notify-send "Screenshot" "Full screen saved to Screenshots" -i "$filepath" ;;
esac
